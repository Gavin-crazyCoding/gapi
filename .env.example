# ── gapi 配置示例：复制为 .env 后修改 ─────────────────────────────

# FreeLLM API（upstream）。unified key 从 FreeLLM dashboard 的
# Settings → API Key 获取（形如 freellmapi-xxxxxxxxxxxxxxxx），
# 或首次启动 server 时 stdout 打印的 "Your unified API key:"。
FREELLM_API_BASE=http://localhost:3001/v1
FREELLM_API_KEY=freellmapi-xxxxxxxxxxxx

# gapi 自己的密钥与数据库
GAPI_JWT_SECRET=change-me-to-a-long-random-string
GAPI_DATABASE_URL=sqlite:///./data/gapi.db
GAPI_DEFAULT_CURRENCY=GavinCoin

# 配额计划汇率：1 GavinCoin 购买多少「千 token」的周期配额。
# 100 = ◎1 换 10 万 token（相对按量费率是批量折扣价）。
GAPI_TOKEN_PACKAGE_RATE=100

# 上游超时（秒）
GAPI_UPSTREAM_TIMEOUT_CHAT=300
GAPI_UPSTREAM_TIMEOUT_EMBEDDINGS=60
GAPI_UPSTREAM_TIMEOUT_MEDIA=300

# 注册：新账号赠送的 GavinCoin 数量
GAPI_REGISTRATION_BONUS=20

# 转发面单请求体上限（字节）。网关自身硬顶，不依赖 upstream 的 25MB。
GAPI_MAX_BODY_BYTES=26214400

# 可信反向代理 IP（逗号分隔）。仅当直接对端在列表内时才采信
# X-Forwarded-For 做限流键；gapi 直接暴露公网时留空（不信任 XFF）。
GAPI_TRUSTED_PROXY_IPS=

# CORS 允许的来源（逗号分隔）。空值 = 完全禁用 CORS（对直接暴露的
# 网关是安全默认值）。仅面板来源需要在此列出；转发面（/v1/*）不在
# 此列，因为它自己有 gapi Key 认证。
GAPI_CORS_ALLOWED_ORIGINS=

# 验证邮件（可选；GAPI_EMAIL_ENABLED=false 时注册不依赖邮件可达）
# 端口 465 走 SMTPS，其余端口走明文/STARTTLS
GAPI_EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=noreply@gapi.local
# 验证邮件链接里使用的外网地址
BASE_URL=http://localhost:3002

